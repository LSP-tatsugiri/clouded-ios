{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": { "source": "git", "url": "https://github.com/mattpocock/skills.git" }
    },
    "ecc": {
      "source": { "source": "git", "url": "https://github.com/affaan-m/ECC.git" }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-status.mjs\" --before", "timeout": 30, "statusMessage": "checking what the other machine pushed" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-status.mjs\" --after", "timeout": 15 }
        ]
      }
    ]
  }
}
