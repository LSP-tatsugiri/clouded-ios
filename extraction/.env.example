# copy this file to .env (keep the example around) and fill in your key
# get one at https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# optional: override the model. Default is claude-sonnet-5 (decided 2026-09-12;
# sonnet-4-5 retires from Sep 29 2026). Changing this invalidates the cache.
MODEL=claude-sonnet-5
